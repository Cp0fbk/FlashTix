# Database (used by Spring and docker-compose)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flashtix
DB_USER=postgres
DB_PASS=your_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Optional: Spring profile
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8082

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_must_be_at_least_256_bits
JWT_EXPIRATION=86400000

# Minio (for local development)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=flashtix-images
MINIO_SECURE=false

# Payment - MoMo (SANDBOX - For Testing)
MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_ENDPOINT=https://test-payment.momo.vn
MOMO_CREATE_URL=/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:5173/payment/success
MOMO_IPN_URL=your_ngrok_url/api/v1/payment/ipn

# Email Service (SMTP Configuration)
# For Gmail: Use App Password (https://myaccount.google.com/apppasswords)
# For other providers: Use your SMTP credentials
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_FROM=your_email@gmail.com
MAIL_FROM_NAME=FlashTix

# Alternative Email Providers:
# SendGrid: smtp.sendgrid.net, port 587
# Mailgun: smtp.mailgun.org, port 587
# Mailtrap (testing): smtp.mailtrap.io, port 2525
